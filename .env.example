# ---------------------------------------------------------------------------
# aitrust-agent-starter-ts-blank-claude-agent — environment
#
# The agent loop is driven by the Claude Agent SDK (@anthropic-ai/claude-agent-sdk).
# The standalone build needs no external messaging, payment, or signing service. It needs
# an Anthropic API key to run, and an AI Trust tenant only when you reach the
# platform steps of the guide.
#
# Copy this file to `.env` and fill in your key:
#   cp .env.example .env      (Windows PowerShell: copy .env.example .env)
# ---------------------------------------------------------------------------

# Required — your Anthropic API key (https://console.anthropic.com/).
# The Claude Agent SDK spawns its bundled Claude Code runtime as a subprocess
# and passes this key through; no separately-installed CLI is required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — HTTP port the app listens on (default 3005).
PORT=3005

# Optional — main agent model and the vision model used by assess_damage.
AGENT_MODEL=claude-opus-4-8
VISION_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# The variables below are NOT used yet. The integration guide introduces them
# as you work through it. Leave them commented out for now.
#
# What each one is and where to get it: the env-var reference on the developer
# portal's Operations page.
# ---------------------------------------------------------------------------

# --- Agent identity: the agent becomes a platform tenant --------------------
# AITRUST_MANAGEMENT_URL=      # Management API base URL (port 8100)
# AITRUST_AUDIT_URL=           # Audit Service base URL (port 8101)
# AITRUST_IDP_URL=             # Identity provider base URL
# AITRUST_CLIENT_ID=           # OAuth client id issued at agent registration
# AITRUST_CLIENT_SECRET=       # OAuth client secret
# AITRUST_AGENT_ID=insurance-claims-agent

# The IDP realm. Set it explicitly to match your environment.
# AITRUST_REALM=agenttrust

# --- Human approval (CIBA) --------------------------------------------------
# Login hint for the person who approves. Delivery is standalone — the request
# goes to the approver's enrolled mobile approver app to approve/deny; the
# approver must be enrolled on a device with the app installed. See README.md.
# APPROVER_EMAIL=
